# Basis-URL der Maximo-Instanz
MAXIMO_BASE_URL=https://maximo.example.com

# Firmenspezifischer API-Pfad fuer den Asset-Import
MAXIMO_ASSET_IMPORT_PATH=/maximo/oslc/os/mxasset

# Cookie-Name fuer die Session. In vielen Umgebungen: LtpaToken2
MAXIMO_COOKIE_NAME=LtpaToken2

# HTTP-Methode fuer den Import
MAXIMO_HTTP_METHOD=POST

# TLS-Zertifikat pruefen
MAXIMO_VERIFY_TLS=true

# Erst auf false setzen, wenn das Mapping und der Endpoint verifiziert wurden
MAXIMO_DRY_RUN=true

# Optional: Payload unter einem Wrapper-Key einbetten, z. B. asset
MAXIMO_REQUEST_WRAPPER_KEY=

# Optional: Zusatzheader als JSON, z. B. {"x-method-override":"BULK"}
MAXIMO_EXTRA_HEADERS_JSON=

# Optional: Pause zwischen Requests in Millisekunden
MAXIMO_ROW_DELAY_MS=0
